[Unit]
Description=LS Detailing Leads API
After=network.target

[Service]
Type=simple
User=ls-detailing
WorkingDirectory=/opt/ls-detailing/backend
EnvironmentFile=/etc/ls-detailing/leads.env
ExecStart=/usr/bin/node src/server.js
Restart=always
RestartSec=3
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ReadWritePaths=/var/lib/ls-detailing

[Install]
WantedBy=multi-user.target
